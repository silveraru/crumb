NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://crumb:crumb@localhost:5432/crumb

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=
# Keyed hash for phone numbers. NEVER change after launch or every user loses their account.
PHONE_PEPPER=

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional tuning
FEED_RADIUS_KM=8
FEED_MAX_AGE_HOURS=168
MAX_LOCATION_ACCURACY_M=500
MAX_TRAVEL_SPEED_MPS=280
